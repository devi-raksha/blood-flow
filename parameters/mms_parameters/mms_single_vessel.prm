# ============================================================================
#  Unsteady MMS convergence test  --  Lucca et al. JCP 495 (2023) style
#  SI units (m, kg, s, Pa).  (A, U) primary variables, L = 1 m as in Lucca.
#
#  Design:
#    A(x,t) = A_d + alpha_A * (1 - cos(2 pi t/T)) * sin(2 pi x/L)
#    U(x,t) = alpha_U * sin(2 pi t/T) * cos(2 pi x/L)
#  Guarantees A(x,0) = A_d, U(x,0) = 0   ->  matches compute_initial_solution
#  Guarantees A(x,T) = A_d, U(x,T) = 0   ->  full period returns to rest
#
#  Parameters (SI, from single_vessel_mms_si.vtk):
#    A_d  = 4.5239e-4 m^2      L    = 1.0     m
#    rho  = 1060      kg/m^3    T    = 1.0     s
#    beta = 1134.370465 Pa*m   (= (4/3) sqrt(pi) E h_w with E=4e5, h_w=1.2e-3)
#    beta/(2 rho A_d)         = 1182.785667
#    alpha_A = 5e-5 m^2  (peak dA = +/-1e-4 m^2, ~22%)
#    alpha_U = 0.5  m/s  (physiological arterial peak velocity)
#
#  Wave speed c(A_d) ~ 5.02 m/s;  U/c = 0.10 (subcritical).
#
#  Forcings:
#    S_A = dA/dt + U * dA/dx + A * dU/dx
#    S_U = dU/dt + U * dU/dx + (beta/(2 rho A_d sqrt(A))) * dA/dx
#
#  Derivative coefficients (with L=T=1, they simplify beautifully):
#    dA/dt coeff = alpha_A * 2 pi = 3.1415926536e-4
#    dA/dx coeff = alpha_A * 2 pi = 3.1415926536e-4
#    dU/dt coeff = alpha_U * 2 pi = 3.1415926536
#    dU/dx coeff = alpha_U * 2 pi = 3.1415926536  (with minus sign in dU/dx)
# ============================================================================

subsection Blood Flow Parameters
  set Density (rho)                                   = 1060.0
  set Reflection coefficient at outflow boundary (Rt) = 0.0
  set Tube law exponent (m)                           = 0.5
  set Viscosity coefficient (mu)                      = 0.0
  set Profile constant for friction term (xi)         = 0.0
end

subsection Functions
  set Inflow function = 20

  # 4 components: A ; U ; A_hat ; U_hat  (comps 2,3 masked in compute_errors)
  set Exact solution = 4.5239e-4 + 5.0e-5*(1-cos(6.283185307179586*t))*sin(6.283185307179586*x); 0.5*sin(6.283185307179586*t)*cos(6.283185307179586*x); 4.5239e-4 + 5.0e-5*(1-cos(6.283185307179586*t))*sin(6.283185307179586*x); 0.5*sin(6.283185307179586*t)*cos(6.283185307179586*x)

  # 2 components: S_A ; S_U
  # S_A = 3.14159e-4 * sin(wt t) sin(wx x)                              [dA/dt]
  #     + [0.5 sin(wt t) cos(wx x)] * [3.14159e-4 (1-cos(wt t)) cos(wx x)]  [U dA/dx]
  #     - [A]                     * [3.14159 sin(wt t) sin(wx x)]           [A dU/dx]
  #
  # S_U = 3.14159 * cos(wt t) cos(wx x)                                 [dU/dt]
  #     - [0.5 sin(wt t) cos(wx x)] * [3.14159 sin(wt t) sin(wx x)]     [U dU/dx]
  #     + [1182.785667 / sqrt(A)] * [3.14159e-4 (1-cos(wt t)) cos(wx x)]  [(1/rho) P' dA/dx]
  set RHS expression = 3.1415926536e-4*sin(6.283185307179586*t)*sin(6.283185307179586*x) + 0.5*sin(6.283185307179586*t)*cos(6.283185307179586*x)*3.1415926536e-4*(1-cos(6.283185307179586*t))*cos(6.283185307179586*x) - (4.5239e-4 + 5.0e-5*(1-cos(6.283185307179586*t))*sin(6.283185307179586*x))*3.1415926536*sin(6.283185307179586*t)*sin(6.283185307179586*x); 3.1415926536*cos(6.283185307179586*t)*cos(6.283185307179586*x) - 0.5*sin(6.283185307179586*t)*cos(6.283185307179586*x)*3.1415926536*sin(6.283185307179586*t)*sin(6.283185307179586*x) + 1182.785667/sqrt(4.5239e-4 + 5.0e-5*(1-cos(6.283185307179586*t))*sin(6.283185307179586*x))*3.1415926536e-4*(1-cos(6.283185307179586*t))*cos(6.283185307179586*x)
end

subsection BloodFlowSystem<1, 3>
  set Finite element degree               = 3
  set Number of global refinement         = 2
  set Number of refinement cycles         = 5
  set Output filename                     = solution
  set Theta (penalty parameter)           = 0.5
  set Theta Boundary (stability parameter)= 0.5
  set Use direct solver                   = true
  set Use junction mesh                   = false
  set Verbosity (console depth)           = 1
  set Numerical flux type                 = HLL
  set Outlet boundary condition type      = Dirichlet
  set Vtk file path for mesh input        = ../../blood-flow/parameters/mms_single_vessel.vtk
  subsection IDA parameters
    set Final time                        = 1
    set Initial time                      = 0
    set Time interval between each output = 0.1
    subsection Error control
      set Absolute error tolerance = 1e-12
      set Relative error tolerance = 1e-12
    end
    subsection Running parameters
      set Initial step size                      = 5e-04
      set Maximum number of nonlinear iterations = 10
      set Maximum order of BDF                   = 5
      set Minimum step size                      = 1e-10
    end
  end
end
